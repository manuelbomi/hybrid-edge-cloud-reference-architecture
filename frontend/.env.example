# Copy to `.env` (or `.env.local`) to point the dashboard at a
# non-default cloud ingest API / edge local API when running `npm run dev`
# or `npm run build`. Both default to the ports used in README.md's
# "Setup & run instructions" when unset.

VITE_INGEST_API_URL=http://localhost:8080
VITE_EDGE_API_URL=http://localhost:8000
