# Cloud-side image: ingest API + dashboard.
# Which process runs is chosen by the `command:` in docker-compose.cloud.yml,
# so this single image serves both cloud-side services.

FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY cloud/ ./cloud/

ENV PYTHONPATH=/app
EXPOSE 8080

CMD ["uvicorn", "cloud.ingest_api:app", "--host", "0.0.0.0", "--port", "8080"]
